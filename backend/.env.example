# Application Settings
PROJECT_NAME="HomeServe Technologies SaaS Platform"
SECRET_KEY="super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: Leave empty for zero-setup local SQLite fallback, or provide MySQL URL:
# DATABASE_URL="mysql+pymysql://<user>:<password>@<host>:3306/<database>?ssl_ca=/etc/ssl/cert.pem"
DATABASE_URL="sqlite:///./homeserve.db"

# Payment Gateway (Razorpay Test Mode / Simulated Sandbox)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
