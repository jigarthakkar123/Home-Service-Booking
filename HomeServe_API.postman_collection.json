{
  "info": {
    "name": "HomeServe Technologies SaaS Platform API",
    "description": "Comprehensive Postman API Collection for Home Services Booking SaaS Platform (FastAPI + JWT + RBAC)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "Login - Super Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@homeserve.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Service Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"provider@homeserve.com\",\n  \"password\": \"Provider@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@homeserve.com\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Technician",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"technician@homeserve.com\",\n  \"password\": \"Technician@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Categories & Services",
      "item": [
        {
          "name": "List All Active Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "List All Services (Search & Filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/services?search=AC&max_price=2000",
              "host": ["{{baseUrl}}"],
              "path": ["services"],
              "query": [
                { "key": "search", "value": "AC" },
                { "key": "max_price", "value": "2000" }
              ]
            }
          }
        },
        {
          "name": "Get Service Detail with Available Providers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/services/ac-deep-jet-servicing", "host": ["{{baseUrl}}"], "path": ["services", "ac-deep-jet-servicing"] }
          }
        }
      ]
    },
    {
      "name": "3. Bookings & Appointments",
      "item": [
        {
          "name": "Create New Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"provider_id\": 1,\n  \"scheduled_date\": \"2026-11-10\",\n  \"scheduled_slot\": \"09:00 - 11:00\",\n  \"problem_description\": \"Air conditioner cooling low\",\n  \"coupon_code\": \"WELCOME50\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "List User Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Get Booking Details by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/1", "host": ["{{baseUrl}}"], "path": ["bookings", "1"] }
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings/1/status", "host": ["{{baseUrl}}"], "path": ["bookings", "1", "status"] }
          }
        }
      ]
    },
    {
      "name": "4. Payments & Invoices",
      "item": [
        {
          "name": "Calculate Charges & Discount",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"coupon_code\": \"WELCOME50\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/calculate", "host": ["{{baseUrl}}"], "path": ["payments", "calculate"] }
          }
        },
        {
          "name": "Process Payment (Sandbox Simulation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1,\n  \"payment_gateway\": \"mock_sandbox\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/process", "host": ["{{baseUrl}}"], "path": ["payments", "process"] }
          }
        },
        {
          "name": "Get Invoice for Booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/payments/invoices/1", "host": ["{{baseUrl}}"], "path": ["payments", "invoices", "1"] }
          }
        }
      ]
    },
    {
      "name": "5. Analytics & Reports",
      "item": [
        {
          "name": "Admin Dashboard Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/analytics/admin", "host": ["{{baseUrl}}"], "path": ["analytics", "admin"] }
          }
        },
        {
          "name": "Export Bookings CSV",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/analytics/export/bookings/csv", "host": ["{{baseUrl}}"], "path": ["analytics", "export", "bookings", "csv"] }
          }
        }
      ]
    }
  ]
}
